DJANGO_SECRET_KEY=
DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
MIGRATE_DB_PASSWORD=
BACKUP_DB_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=0
MAIL_FROM=
